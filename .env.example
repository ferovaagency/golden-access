# Ferova OS necesita estas variables PÚBLICAS para inicializar el cliente de Supabase.
# Lovable Cloud debe inyectarlas en sus despliegues conectados. Estas líneas sirven
# únicamente para desarrollo local o para un entorno de compilación externo.
# La clave publishable es apta para el navegador; la protección de datos depende de RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave-publica>

# PayPal Client ID (cliente, público). No incluir el Secret ni el Webhook ID en VITE_.
# VITE_PAYPAL_CLIENT_ID=xxx

# Configurar solo como secretos de Supabase Edge Functions, nunca en este archivo:
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# Rediseño Ferova One v2 (Manual_Implementacion_Diseno_Ferova_One). Apagado
# por defecto -- activar solo cuando el AppShell v2 este listo para probarse.
# VITE_FEROVA_UI_V2=true

# Whop (nov 2026): planes Gratis / Medio (USD 20) / Pro (USD 50).
# En el navegador: ids de los planes creados en Whop (plan_…). Son públicos.
# VITE_WHOP_PLAN_MEDIO_MENSUAL=plan_...
# VITE_WHOP_PLAN_MEDIO_ANUAL=plan_...
# VITE_WHOP_PLAN_PRO_MENSUAL=plan_...
# VITE_WHOP_PLAN_PRO_ANUAL=plan_...
# VITE_WHOP_ENV=production   (sandbox para probar con tarjetas de prueba)
# Precios mostrados (USD). Por defecto mensual 20 / 50 y anual 168 / 420.
# VITE_PLAN_PRICE_MEDIO=20
# VITE_PLAN_PRICE_MEDIO_ANUAL=168
# VITE_PLAN_PRICE_PRO=50
# VITE_PLAN_PRICE_PRO_ANUAL=420
# Sólo como secretos de las edge functions (nunca aquí):
# WHOP_API_KEY=              consulta y gestiona membresías (whop-webhook, whop-manage-subscription); requiere member:manage
# WHOP_WEBHOOK_SECRET=       secreto ws_… del webhook (se muestra una sola vez al crearlo)
# WHOP_PLAN_MEDIO_MENSUAL=   mismos ids plan_… que arriba, para traducir el plan comprado
# WHOP_PLAN_MEDIO_ANUAL=
# WHOP_PLAN_PRO_MENSUAL=
# WHOP_PLAN_PRO_ANUAL=
# WHOP_ENV=sandbox           sólo para probar contra sandbox.whop.com
