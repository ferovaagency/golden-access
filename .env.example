# Ferova OS necesita estas variables PÚBLICAS para inicializar el cliente de Supabase.
# Lovable Cloud debe inyectarlas en sus despliegues conectados. Estas líneas sirven
# únicamente para desarrollo local o para un entorno de compilación externo.
# La clave publishable es apta para el navegador; la protección de datos depende de RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave-publica>

# PayPal Client ID (cliente, público). No incluir el Secret ni el Webhook ID en VITE_.
# VITE_PAYPAL_CLIENT_ID=xxx

# Configurar solo como secretos de Supabase Edge Functions, nunca en este archivo:
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# Rediseño Ferova One v2 (Manual_Implementacion_Diseno_Ferova_One). Apagado
# por defecto -- activar solo cuando el AppShell v2 este listo para probarse.
# VITE_FEROVA_UI_V2=true

# Paddle (Freemium + 3 planes, oct 2026). Token de cliente y un price id por
# plan y periodo. Un price que falte deja ese botón en "próximamente".
# VITE_PADDLE_CLIENT_TOKEN=
# VITE_PADDLE_ENV=production
# VITE_PADDLE_PRICE_BASICO_MENSUAL=pri_...
# VITE_PADDLE_PRICE_BASICO_ANUAL=pri_...
# VITE_PADDLE_PRICE_INTERMEDIO_MENSUAL=pri_...
# VITE_PADDLE_PRICE_INTERMEDIO_ANUAL=pri_...
# VITE_PADDLE_PRICE_FULL_MENSUAL=pri_...
# VITE_PADDLE_PRICE_FULL_ANUAL=pri_...
# Precios mostrados (USD/mes). Por defecto 19 / 49 / 99; deben coincidir con Paddle.
# VITE_PLAN_PRICE_BASICO=19
# VITE_PLAN_PRICE_INTERMEDIO=49
# VITE_PLAN_PRICE_FULL=99
